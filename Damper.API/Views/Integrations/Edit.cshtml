@model Damper.API.ViewModels.Integrations.IntegrationEditModel

@{
    ViewData["Title"] = "Edit Integration";
}

<h1>Edit Integration</h1>

<p>
    <a href="/admin/integrations">← Back to Integrations</a>
    <span> | </span>
    <a href="/admin/integrations/rotateapikey/@Model.Id">Rotate API Key</a>
</p>

<form method="post">
    <input asp-for="Id" type="hidden" />

    <div asp-validation-summary="ModelOnly"></div>

    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" />
        <span asp-validation-for="Name"></span>
    </div>

    <div class="form-group">
        <label asp-for="Description"></label>
        <input asp-for="Description" />
    </div>

    <div class="form-group checkbox">
        <input asp-for="Enabled" />
        <label asp-for="Enabled">Integration Enabled</label>
    </div>

    <div class="form-group checkbox">
        <input asp-for="IngressEnabled" />
        <label asp-for="IngressEnabled">Ingress Enabled</label>
    </div>

    <div class="form-group checkbox">
        <input asp-for="DeliveryEnabled" />
        <label asp-for="DeliveryEnabled">Delivery Enabled</label>
    </div>

    <div class="form-group">
        <label asp-for="DestinationUri">Destination URI</label>
        <input asp-for="DestinationUri" />
        <span asp-validation-for="DestinationUri"></span>
    </div>

    <h2>Delivery Settings</h2>

    <div class="form-group">
        <label asp-for="RequestsPerInterval">Requests Per Interval</label>
        <input asp-for="RequestsPerInterval" type="number" />
        <span asp-validation-for="RequestsPerInterval"></span>
    </div>

    <div class="form-group">
        <label asp-for="DeliveryIntervalMillis">Delivery Interval (ms)</label>
        <input asp-for="DeliveryIntervalMillis" type="number" />
        <span asp-validation-for="DeliveryIntervalMillis"></span>
    </div>

    <div class="form-group">
        <label asp-for="MaxRetryAttempts">Max Retry Attempts</label>
        <input asp-for="MaxRetryAttempts" type="number" />
        <span asp-validation-for="MaxRetryAttempts"></span>
    </div>

    <div class="form-group">
        <label asp-for="InitialRetryDelayMillis">Initial Retry Delay (ms)</label>
        <input asp-for="InitialRetryDelayMillis" type="number" />
        <span asp-validation-for="InitialRetryDelayMillis"></span>
    </div>

    <div class="form-group">
        <label asp-for="RetryBackoffMultiplier">Retry Backoff Multiplier</label>
        <input asp-for="RetryBackoffMultiplier" type="number" step="0.1" />
        <span asp-validation-for="RetryBackoffMultiplier"></span>
    </div>

    <div class="form-group">
        <label asp-for="MaximumRetryDelayMillis">Maximum Retry Delay (ms)</label>
        <input asp-for="MaximumRetryDelayMillis" type="number" />
        <span asp-validation-for="MaximumRetryDelayMillis"></span>
    </div>

    <div class="form-group">
        <label asp-for="RequestTimeoutMillis">Request Timeout (ms)</label>
        <input asp-for="RequestTimeoutMillis" type="number" />
        <span asp-validation-for="RequestTimeoutMillis"></span>
    </div>

    <div class="form-group">
        <label asp-for="MaxQueueCapacity">Max Queue Capacity</label>
        <input asp-for="MaxQueueCapacity" type="number" />
        <span asp-validation-for="MaxQueueCapacity"></span>
    </div>

    <h2>Outbound Authentication</h2>

    <div class="form-group">
        <label asp-for="AuthenticationType">Authentication Type</label>
        <select asp-for="AuthenticationType"
                asp-items="Html.GetEnumSelectList<AuthenticationType>()">
        </select>
    </div>

    <div class="form-group">
        <label asp-for="AuthenticationUsername">Username</label>
        <input asp-for="AuthenticationUsername" />
        <span asp-validation-for="AuthenticationUsername"></span>
        <small>Used only for Basic authentication.</small>
    </div>

    <div class="form-group">
        <label asp-for="AuthenticationHeaderName">Header Name</label>
        <input asp-for="AuthenticationHeaderName" />
        <span asp-validation-for="AuthenticationHeaderName"></span>
        <small>Used only for Custom Header authentication.</small>
    </div>

    <div class="form-group">
        <label asp-for="AuthenticationSecret">New Secret</label>

        <input id="AuthenticationSecret"
               name="AuthenticationSecret"
               type="password"
               autocomplete="new-password" />

        <span asp-validation-for="AuthenticationSecret"></span>

        <small>
            Leave blank to keep the existing secret when the authentication type is unchanged.
        </small>
    </div>

    <button class="button" type="submit">Save</button>
    <a href="/admin/integrations">Cancel</a>
</form>