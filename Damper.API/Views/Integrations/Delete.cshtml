@model Damper.Domain.Integrations.Integration

@{
    ViewData["Title"] = "Delete Integration";
}

<h1>Delete Integration</h1>

<p>
    <a href="/admin/integrations">← Back to Integrations</a>
</p>

<div class="warning">
    <strong>Are you sure you want to delete this Integration?</strong>
    <p>This action cannot be undone.</p>
</div>

<table>
    <tbody>
        <tr>
            <th>Name</th>
            <td>@Model.Name</td>
        </tr>
        <tr>
            <th>Description</th>
            <td>@Model.Description</td>
        </tr>
        <tr>
            <th>Enabled</th>
            <td>@(Model.Enabled ? "Yes" : "No")</td>
        </tr>
        <tr>
            <th>Destination</th>
            <td>@Model.Delivery.Destination.Uri</td>
        </tr>
    </tbody>
</table>

<form asp-action="DeleteConfirmed" method="post" class="delete-form">
    <input type="hidden" name="id" value="@Model.Id" />

    <button type="submit" class="button danger">
        Delete Integration
    </button>

    <a href="/admin/integrations">Cancel</a>
</form>