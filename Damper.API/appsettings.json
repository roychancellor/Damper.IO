{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApplicationData": {
    "RepositorySettings":{
      "CacheTimeToLiveMinutes": 10
    },
    "RabbitMQSettings": {
      "HostName": "localhost",
      "UserName": "damper-user",
      "Password": "damper123",
      "Port": 5672,
      "ExchangeName": "damper.webhook.exchange",
      "VirtualHost": "/",
      "NumberOfShards": 16,
      "IngressShardPrefix": "damper.webhook.queue.shard_",
      "DeadLetterExchange": "damper.dlx",
      "DeadLetterQueue": "damper.webhook.queue.dead_letter",
      "PrefetchSize": 0,
      "PrefetchCount": 30,
      "IsPrefetchGlobal": false,
      "ParkingLotExchange": "damper.parking.exchange",
      "ParkingLotQueue": "damper.webhook.queue.parking",
      "ParkingLotBaseTTLMillis": 60000,
      "ParkingLotJitterMillis": 10000,
      "DefaultMaxQueueCapacity": 5000
    },
    "MetricsSettings":{
      "ServiceName": "Damper.OutboundService",
      "MeterName": "Damper.Core",
      "OtlpEndpoint": "http://localhost:4317"
    },
    "ProcessorSettings":{
      "WaitToWriteExpirationMillis": 1000
    },
    "EgressSettings":{
      "HttpClientName": "DamperEgress",
      "PooledConnectionLifetimeSeconds": 120,
      "PooledConnectionIdleTimeoutSeconds": 60,
      "MaxConnectionsPerServer": 100,
      "EnableMultipleHttp2Connections": true,
      "HandlerLifetimeSeconds": 120,
      "MaxSendAttempts": 5,
      "RequestTimeoutMillis": 10000,
      "RetryBackoffMillis": 2000,
      "RetryBackoffJitterMillis": 200,
      "SystemHeaders": ["Host", "Content-Length", "Connection", "Content-Type"],
      "CircuitBreakerCooldownSeconds": 10
    }
  }
}
